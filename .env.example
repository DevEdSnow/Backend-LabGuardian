
# ============================================================
# LABGUARDIAN AI — EJEMPLO DE VARIABLES DE ENTORNO
# ============================================================
# Copia este archivo como .env y configura tus valores locales.
# No coloques contraseñas ni claves secretas reales aquí.
# ============================================================


# ============================================================
# APLICACIÓN
# ============================================================

APP_NAME=LabGuardian AI
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1


# ============================================================
# SERVIDOR
# ============================================================

HOST=127.0.0.1
PORT=8000


# ============================================================
# BASE DE DATOS — POSTGRESQL
# ============================================================
# Reemplaza los valores de ejemplo con los de tu instalación.

DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/labguardian


# ============================================================
# SEGURIDAD Y AUTENTICACIÓN
# ============================================================
# Genera una clave propia para tu archivo .env.
# No reutilices esta clave de ejemplo en producción.

SECRET_KEY=replace_with_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================================
# CORS — ORÍGENES PERMITIDOS
# ============================================================

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173


# ============================================================
# MACHINE LEARNING
# ============================================================

ML_ENABLED=true
RISK_MODEL_PATH=models/risk_model.joblib
ANOMALY_MODEL_PATH=models/anomaly_model.joblib
ML_CONFIDENCE_THRESHOLD=0.70


# ============================================================
# UMBRALES DE DEMOSTRACIÓN PARA MUESTRAS
# ============================================================
# Valores ilustrativos, no validados para decisiones clínicas.

MIN_SAMPLE_TEMPERATURE=2.0
MAX_SAMPLE_TEMPERATURE=8.0

MAX_TRANSPORT_MINUTES=30
MAX_PROCESSING_MINUTES=60
MAX_STORAGE_MINUTES=120


# ============================================================
# UMBRALES DE RIESGO
# ============================================================
# Deben coincidir con los utilizados en risk_service.py.

RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
RISK_CRITICAL_THRESHOLD=85


# ============================================================
# CÓDIGOS QR
# ============================================================

QR_BASE_URL=http://localhost:5173


# ============================================================
# REGISTRO DE EVENTOS Y LOGS
# ============================================================

LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE_PATH=logs/labguardian.log


# ============================================================
# ZONA HORARIA
# ============================================================

TIMEZONE=America/Mexico_City


# ============================================================
# BASE DE DATOS PARA PRUEBAS
# ============================================================
# Solo se utilizará si la configuración de tests la implementa.

TEST_DATABASE_URL=sqlite:///./test_labguardian.db
