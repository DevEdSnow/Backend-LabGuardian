
# ============================================================
# LABGUARDIAN AI — VARIABLES DE ENTORNO
# ============================================================
# Archivo: backend/.env
# IMPORTANTE: No subir este archivo a repositorios públicos.
# ============================================================


# ============================================================
# APLICACIÓN
# ============================================================

APP_NAME=LabGuardian AI
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1


# ============================================================
# SERVIDOR
# ============================================================

HOST=127.0.0.1
PORT=8000


# ============================================================
# BASE DE DATOS — POSTGRESQL
# ============================================================
# Ajusta usuario, contraseña, host, puerto y base de datos
# según tu instalación local de PostgreSQL.

DATABASE_URL=postgresql+psycopg://postgres:CAMBIA_ESTA_PASSWORD@localhost:5432/labguardian


# ============================================================
# SEGURIDAD Y AUTENTICACIÓN
# ============================================================
# Sustituye el valor de SECRET_KEY por una clave aleatoria segura.
# Puedes generarla con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=REEMPLAZA_CON_UNA_CLAVE_ALEATORIA_SEGURA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================================
# CORS — ORÍGENES PERMITIDOS
# ============================================================
# Separa los orígenes mediante comas.
# Agrega aquí el origen de tu frontend cuando lo tengas.

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173


# ============================================================
# MACHINE LEARNING
# ============================================================

ML_ENABLED=true

RISK_MODEL_PATH=models/risk_model.joblib
ANOMALY_MODEL_PATH=models/anomaly_model.joblib

ML_CONFIDENCE_THRESHOLD=0.70


# ============================================================
# UMBRALES DE DEMOSTRACIÓN PARA EL ANÁLISIS DE RIESGOS
# ============================================================
# Estos valores deben validarse con los protocolos del laboratorio.
# No constituyen criterios clínicos validados.

MIN_SAMPLE_TEMPERATURE=2.0
MAX_SAMPLE_TEMPERATURE=8.0

MAX_TRANSPORT_MINUTES=30
MAX_PROCESSING_MINUTES=60
MAX_STORAGE_MINUTES=120

RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
RISK_CRITICAL_THRESHOLD=85


# ============================================================
# CÓDIGOS QR
# ============================================================
# URL base del frontend que mostrará la información de la muestra.

QR_BASE_URL=http://localhost:5173


# ============================================================
# REGISTRO DE EVENTOS Y LOGS
# ============================================================

LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE_PATH=logs/labguardian.log


# ============================================================
# ZONA HORARIA
# ============================================================

TIMEZONE=America/Mexico_City


# ============================================================
# CONFIGURACIÓN DE PRUEBAS
# ============================================================
# Los tests deben utilizar una base de datos aislada.
# No reemplaces DATABASE_URL por esta variable sin implementar
# explícitamente su lectura en la configuración de pruebas.

TEST_DATABASE_URL=sqlite:///./test_labguardian.db
